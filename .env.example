# Server-only variables (Vercel → Settings → Environment Variables). Never put real values in the repo: it is public.

# Firebase Console → Project settings → Service accounts → Generate new private key; paste the whole JSON on one line
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# @BotFather token of @Willy_Billi_bot
TELEGRAM_BOT_TOKEN="123456:ABC..."

# Any random string; the same value goes into setWebhook's secret_token
TELEGRAM_WEBHOOK_SECRET="random-string"
